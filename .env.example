# LLM Configuration
LLAMA_API_BASE=http://localhost:11434
LLAMA_MODEL=llama2:7b
LLAMA_TEMPERATURE=0.7
LLAMA_MAX_TOKENS=4096

# Database Configuration
DATABASE_URL=sqlite:///./supply_chain.db
# DATABASE_URL=postgresql://user:password@localhost/supply_chain
# DATABASE_URL=mysql://user:password@localhost/supply_chain

# API Integrations
API_KEY_SAP=your_sap_api_key
API_KEY_ORACLE=your_oracle_api_key
API_KEY_EXTERNAL_SERVICE=your_external_api_key

# File Paths
DATA_DIR=./data
EXPORT_DIR=./data/exports
LOG_DIR=./logs

# Agent Configuration
AGENT_LOG_LEVEL=INFO
AGENT_TIMEOUT=300
MAX_ITERATIONS=10

# Development
DEBUG=False
ENVIRONMENT=development
